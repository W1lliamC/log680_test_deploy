# App
PORT=8080
LOG_LEVEL=INFO

# GitHub
GITHUB_TOKEN=ghp_xxx
GITHUB_OWNER=your-org-or-user
GITHUB_REPO=your-repo

# Kanban (MVP = colonnes via labels GitHub)
KANBAN_DONE_LABEL=Done
KANBAN_DOING_LABEL=Doing
KANBAN_TODO_LABEL=To Do

# DB
POSTGRES_DSN=postgresql+psycopg2://postgres:postgres@db:5432/metrics
# Fallback dev local (si nécessaire) : sqlite
# SQLITE_DSN=sqlite:///./dev.db
